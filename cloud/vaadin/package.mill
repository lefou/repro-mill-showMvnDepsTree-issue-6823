    Deps.kotlin.serializationCore,
    Deps.kotlin.serializationJson,
    Deps.kotlin.coroutines,
    Deps.kotlin.coroutinesJdk8,
    Deps.kotlin.reflect,
    Deps.kotlin.dataFrame,
    Deps.kotlin.dataFrameExcel,
    Deps.kotlin.dataFrameAnnoProc,
    // transitive deps of arrow/dataframe
    Deps.netty.common,
    Deps.kotlinArrow.core,
    Deps.kotlinArrow.coroutines,
    Deps.kotlinx.htmlJvm,
    Deps.caffeine,
    Deps.commonsCodec,
    Deps.commonsFileupload,
    Deps.commonsIo,
    Deps.jclOverSlf4j,
    Deps.javaxValidationApi,
    Deps.jacksonKotlin,
    Deps.byteBuddy,
    Deps.commonsCompress,
    Deps.commonsLang3,
    Deps.httpclient,
    Deps.httpcore,
    Deps.jsoup,
    Deps.felixGogoShell,
    Deps.felixGogoCommand,
    Deps.felixGogoRuntime,
    Deps.felixMetatype,
    Deps.felixConfigadmin,
    Deps.felixScr,
    Deps.ulid,
    Deps.vaadin.vaadinConfirmDialogFlow,
    Deps.vaadin.vaadinChartsFlow,
    Deps.vaadin.vaadinBoardFlow,
    Deps.vaadin.vaadinCore,
//    Deps.vaadinToggle,
    Deps.springBoot.starterWeb,
    Deps.vaadin.vaadinSpringBootStarter,
    Deps.springBoot.starterCache,
    // This is a scala dependency
    Deps.jacksonScala.nonScalaDep,
    Deps.jsonPath,
    // transitive dependency of vaadin-flow-server
    Deps.phCommons_c,
    // This is a scala dependency
    Deps.pekko.actor.nonScalaDep,
    Deps.logstashLockbackEncoder,
    Deps.spring.web(),
    Deps.springSecurityWeb,
    Deps.springSecurityConfig,
    Deps.springBoot.starterOauth2Client,
    Deps.vaadin.flowServer,
