// cloud.vaadin
object `package` extends Module,
  AcmeKotlinModule,
  CloudDependencySetup {  vaadinBaseModule =>
  override def moduleDeps = Seq(
    asbBaseForCloud,
    asbMockserverForCloud,
    asbReplayserverForCloud,
    framework.equinoxupdate.equinoxupdate,
    rmfAppForCloud,
    kernelForCloud,
    app.i18n,
    app.i18n_extension,
    rcpBundleForCloud,
    contractmngAppForCloud
  )

  // Maven compatible source layout to also compile with gradle
  override def sources: T[Seq[PathRef]] = Task.Sources(moduleDir / "src" / "main" / "java")

  override def resources: T[Seq[PathRef]] = Task.Sources(moduleDir / "src" / "main" / "resources")

  override def compileMvnDeps = DepSeq(
    Deps.osgiCore
  )

  override def bomMvnDeps = DepSeq(
    Deps.vaadin.vaadinBom
  )

  override def mvnDeps = DepSeq(
    Deps.kotlin.stdlibCommon,
