object `package` extends Module { framework =>

  object equinoxupdate extends Module {
    object equinoxupdate extends AcmeOsgiModule {
      override def artifactName: T[String] = "de.acme.equinoxupdate"
      override def mvnDeps = super.mvnDeps() ++ DepSeq(
        Deps.slf4j,
        Deps.osgiCore,
        Deps.cmdOption
      )
      override def compileMvnDeps = super.compileMvnDeps() ++ Seq(
        ED.`org.eclipse.osgi`,
        ED.`org.eclipse.core.runtime`,
        ED.`org.eclipse.equinox.common`
      )
      override def runMvnDeps = super.runMvnDeps() ++ DepSeq(
        Deps.logbackClassic
      )
      override def osgiHeaders = Task {
        super
          .osgiHeaders()
          .copy(
            `Bundle-Activator` = Some("de.acme.equinoxupdate.internal.EquinoxUpdateActivator"),
            `Export-Package` = Seq(
              "de.acme.equinoxupdate",
              "de.acme.equinoxupdate.tools"
            ),
            `Import-Package` = Seq(
              "org.eclipse.core.runtime;registry=!;common=!;resolution:=optional",
              "org.eclipse.*;resolution:=optional",
              "org.apache.commons.logging;resolution:=optional",
              "org.slf4j;resolution:=optional",
              "de.tototec.cmdoption.*;resolution:=optional",
              "*"
            )
          )
      }
      override def additionalHeaders = Task {
        super.additionalHeaders() ++ Map(
          "Main-Class" -> "de.acme.equinoxupdate.tools.ToolsRunner"
        )
      }
      object test extends AcmeModuleTests with TestNg {
        override def moduleDeps = super.moduleDeps ++ Seq(framework.osgiPojosr)
        override def mvnDeps = Task { super.mvnDeps() ++ equinoxupdate.compileMvnDeps() }
        def testDeps = Task {
          defaultResolver().classpath(Seq(mvn"org.glassfish.jaxb:jaxb-runtime:2.3.1"))
            .map { pr =>
              os.copy.into(pr.path, Task.dest)
            }
          Seq(PathRef(Task.dest))
        }
        override def resources: T[Seq[PathRef]] = Task { super.resources() ++ testDeps() }
      }
    }
  }

