  object pojosr extends AcmeOsgiModule {
    val commit = "f495351917b0d122138cd6ea70d6c4e61f475629"
    val gitUrl = s"https://github.com/apache/felix-dev/archive/${commit}.zip"

    // TODO: Use Mill cache API once available
    def testRepoRoot = Task(persistent = true) {
      val rel = os.rel / s"felix-dev-${commit}"
      val dest = Task.dest / rel / rel
      if (!os.exists(dest)) {
        // cleanup older temp files
        os.list(Task.dest).foreach(os.remove.all)
        os.unzip.stream(
          requests.get.stream(gitUrl),
          Task.dest / rel
        )
      }
      assert(os.exists(dest))
      PathRef(dest)
    }
    override def mvnDeps = DepSeq(
      mvn"org.osgi:osgi.core:7.0.0",
      Deps.jbossVfs
    )
    override def sources = Seq(PathRef(testRepoRoot().path / "connect" / "src" / "main" / "java"))
    override def resources = Seq(PathRef(testRepoRoot().path / "connect" / "src" / "main" / "resources"))
    override def osgiHeaders: T[OsgiHeaders] = super.osgiHeaders().copy(
      `Export-Package` = Seq(
        "org.osgi.framework.*",
        "org.osgi.resource",
        "org.osgi.dto",
        "org.osgi.resource.dto",
        "org.osgi.service.url",
        "org.osgi.service.packageadmin",
        "org.osgi.service.startlevel",
        "org.osgi.util.tracker",
        "org.apache.felix.connect.*"
      ),
      `Import-Package` = Seq(
        "!*"
      )
    )
    override def javacOptions = super.javacOptions().filter(_ != "-deprecation")
  }

