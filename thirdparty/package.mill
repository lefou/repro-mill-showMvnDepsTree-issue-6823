/** Marker trait for Modules that need to be provisioned to the dev-machine before development. */
trait ProvisionModule extends Module

// Support trait to use modules that need provisioning directly as ivy dependency
trait ThirdpartyWrapper extends PublishModule {
  def asDep: T[Dep] = Task {
    publishLocalCached()
    publishM2LocalCached()
    import ArtifactOps.AsDep
    artifactMetadata().asDep
  }
}

/** Bundelized version of the datasource proxy tool. */
object datasourceProxy extends AcmeOsgiModule with ThirdpartyWrapper {
  override def artifactName: T[String] = "net.ttddyy.dsproxy"
  override def publishVersion: T[String] = Task { Deps.ttddyyDatasourceProxy.version }
  override def compileMvnDeps: T[Seq[Dep]] = Task { Seq(Deps.ttddyyDatasourceProxy.exclude("*" -> "*")) }
  override def osgiHeaders: T[OsgiHeaders] = Task {
    super
      .osgiHeaders()
      .copy(
        `Import-Package` = Seq(
          "javax.servlet.*;resolution:=optional",
          "org.aopalliance.intercept.*;resolution:=optional",
          "org.apache.commons.logging.*;resolution:=optional",
          "org.slf4j.*;resolution:=optional",
          "org.springframework.beans.factory.*;resolution:=optional",
          "org.springframework.jdbc.support.nativejdbc.*;resolution:=optional",
          "org.springframework.web.servlet.handler.*;resolution:=optional"
        ),
        `Export-Package` = Seq("net.ttddyy.dsproxy.*")
      )
  }
}

// Wrap the original mssql-jdbc driver to include the Windows dll and provide a OSGi artifact
object mssqljdbc extends AcmeOsgiModule with ThirdpartyWrapper with ProvisionModule {
  override def artifactName: T[String] = "de.acme.cmfs.support.microsoft.mssql.jdbc"
  override def publishVersion: T[String] = Deps.mssqlJdbcVersion + "_1"
  override def compileMvnDeps: T[Seq[Dep]] = Seq(Deps.mssqlJdbc_orig)
  def dll: T[PathRef] = Task(persistent = true) {
    val dll = Task.dest / s"mssql-jdbc_auth-${Deps.mssqlJdbcVersion}.x64.dll"
    val url =
      s"https://repo1.maven.org/maven2/com/microsoft/sqlserver/mssql-jdbc_auth/${Deps.mssqlJdbcVersion}.x64/${dll.last}"
    if (!os.exists(dll)) {
      val tmp = Task.dest / s"tmp-${dll.last}"
      os.write.over(tmp, requests.get.stream(url))
      os.copy(tmp, dll)
      os.remove.all(tmp)
    }
    PathRef(dll)
  }
  override def resources: T[Seq[PathRef]] = Task {
    super.resources() ++ {
      val dest = Task.dest
      os.copy.into(dll().path, dest)
      Seq(PathRef(dest))
    }
  }
//  override def pomSettings = super.pomSettings().copy(
//    licenses = Seq(License.MIT)
//  )
  override def osgiHeaders: T[OsgiHeaders] = Task {
    super
      .osgiHeaders()
      .copy(
        `Bundle-Name` = Option(artifactName()),
        `Export-Package` = Seq(
          "com.microsoft.sqlserver.jdbc",
          "com.microsoft.sqlserver.jdbc.dataclassification",
          "com.microsoft.sqlserver.jdbc.osgi",
          "microsoft.sql"
        ),
        `Import-Package` = Seq(
          "com.azure.*;resolution:=optional",
          "com.microsoft.aad.*;resolution:=optional",
          "org.antlr.*;resolution:=optional",
          "org.bouncycastle.*;resolution:=optional",
          "reactor.core.*;resolution:=optional"
        )
      )
  }

  /** Register the embedded ddl to the container runtime. */
  def bundleNativeCodeHeader: T[(String, String)] = Task {
    (
      "Bundle-NativeCode" ->
        s"""${dll().path.last};selection-filter="(&(osgi.arch=x86_64)(osgi.os=win32))",
           |*""".stripMargin
      )
  }

  override def additionalHeaders: T[Map[String, String]] = Task {
    super.additionalHeaders() ++ Map(
      bundleNativeCodeHeader()
    )
  }
  override def explodedJars: T[Seq[PathRef]] = {
    Seq.from(resolvedMvnDeps())
  }
}


object springweb extends AcmeModule with ThirdpartyWrapper with ProvisionModule {
  private val dep = Deps.springNonOsgi.spring("web")
  override def artifactName: T[String] = s"de.acme.cmfs.support.org.springframework.spring-web"
  override def publishVersion: T[String] = s"${dep.version}_1"
  override def compileMvnDeps: T[Seq[Dep]] = Task {
    Seq(dep.exclude("*" -> "*"))
  }
  override def mvnDeps: T[Seq[Dep]] = Seq(
    mvn"org.springframework:spring-beans:${dep.version}",
    mvn"org.springframework:spring-core:${dep.version}"
  )
  override def pomSettings = super.pomSettings().copy(
    organization = "de.acme",
    licenses = Seq(License.`Apache-2.0`)
  )
  def unpacked: T[PathRef] = Task {
    val jar = defaultResolver().classpath(compileMvnDeps()).head.path
    val excludes = Seq(
      "org/springframework/remoting/httpinvoker/HttpInvokerServiceExporter.class"
    )
    AcmeUtil.unpackZip(src = jar, dest = Task.dest, excludes = excludes)
    PathRef(Task.dest)
  }
  override def compile: T[CompilationResult] = Task {
    val dummy = Task.dest / "dummy"
    os.write(dummy, "")
    CompilationResult(dummy, unpacked())
  }
  override def sourceJar: T[PathRef] = Task {
    defaultResolver().classpath(compileMvnDeps(), sources = true).iterator.next()
  }
}

object po4j extends JavaModule with PublishModule with ThirdpartyWrapper with ProvisionModule {
  val po4jVersion =  "0.1.0-bc1da59"
  def repoCommit: T[String] = Task { "8d2a769dc3af0ee21468e09d35f3c688a198867c" }
  def repoCheckout: T[PathRef] = Task(persistent = true) {
    val repo = Task.dest / "repo"
    if (!os.exists(repo / "README.md")) {
      os.call(
        cmd = ("git", "clone", "https://github.com/ThilinaTLM/po4j.git", "repo"),
        cwd = Task.dest
      )
    }
    os.call(cmd = ("git", "checkout", repoCommit()), cwd = repo)
    PathRef(repo)
  }
  override def publishVersion: T[String] = po4jVersion
  override def artifactName: Task.Simple[String] = "po4j"
  override def javacOptions = Seq("-source", "17", "-target", "17", "-encoding" , "UTF-8")
  // Don't show linting output
  override def javadocOptions: T[Seq[String]] = Seq("-Xdoclint:none")
//  override def sources: T[Seq[PathRef]] = Task { Seq(PathRef(repoCheckout().path / "src/main/java")) }
  override def pomSettings: T[PomSettings] = Task {
    PomSettings(
      description = "Mill build version of po4j, a Java library for parsing and writing GNU gettext PO files",
      organization = "com.github.ThilinaTLM",
      url = "https://github.com/ThilinaTLM/po4j",
      licenses = Seq(License.`Apache-2.0`),
      versionControl =
        VersionControl.github(owner = "ThilinaTLM", repo = "po4j"),
      developers = Seq()
    )
  }
  override def compileMvnDeps = DepSeq(
    mvn"org.jspecify:jspecify:1.0.0"
  )
}


// Local publish a specific commit from an external project
object log4jdbc extends JavaModule with PublishModule with ThirdpartyWrapper with ProvisionModule {
  import mill.scalalib.publish.{PomSettings, License, VersionControl}

  val log4jdbcVersion = "1.2-7fce18c"
  def repoCommit: T[String] = Task { "7fce18c56e66a9eff6a840dda984666365dbeb80" }

  def repoCheckout: T[PathRef] = Task(persistent = true) {
    val repo = Task.dest / "repo"
    if (!os.exists(repo / "README.md")) {
      os.call(
        cmd = ("git", "clone", "https://github.com/arthurblake/log4jdbc.git", "repo"),
        cwd = Task.dest
      )
    }
    os.call(cmd = ("git", "checkout", repoCommit()), cwd = repo)
    PathRef(repo)
  }

  override def javacOptions = Seq("-source", "8", "-target", "8", "-Xlint")
  // doclinit produces errors, which stops the jar build
  override def javadocOptions: T[Seq[String]] = Seq("-Xdoclint:none")
  override def publishVersion: T[String] = log4jdbcVersion
  override def artifactName: Task.Simple[String] = "log4jdbc-jdbc4"

//  override def sources: T[Seq[PathRef]] = Task { Seq(PathRef(repoCheckout().path / "src-jdbc4")) }
  override def mvnDeps: T[Seq[Dep]] = Seq(Deps.slf4j)

  override def pomSettings: T[PomSettings] = Task {
    PomSettings(
      description = "Mill build version of log4jdbc, a JDBC proxy driver that logs all SQL without a performance hit.",
      organization = "net.sf.log4jdbc",
      url = "https://github.com/arthurblake/log4jdbc/tree/master",
      licenses = Seq(License.`Apache-2.0`),
      versionControl =
        VersionControl.github(owner = "arthurblake", repo = "log4jdbc"),
      developers = Seq()
    )
  }
}

/**
 * Wrap Javax/Jakarta XML Bind API version 2 (API + Impl) as JAR.
 *
 * https://github.com/jakartaee/jaxb-api/issues/263
 * https://github.com/jakartaee/jaxb-api/issues/263#issuecomment-1216457886
 */
object jakartaXmlBind2 extends AcmeModule with ThirdpartyWrapper with ProvisionModule {
  //  private val dep = Deps.springNonOsgi.spring("web")
  override def artifactName: T[String] = s"de.acme.cmfs.support.jakartaXmlBind2"
  override def compileMvnDeps: T[Seq[Dep]] = Task {
    Seq(
      mvn"javax.xml.bind:jaxb-api:2.3.1",
    mvn"com.sun.xml.bind:jaxb-impl:2.3.9",
    mvn"jakarta.xml.bind:jakarta.xml.bind-api:2.3.3",
    mvn"jakarta.activation:jakarta.activation-api:1.2.2"
    ).map(_.exclude("*" -> "*"))
  }
  override def pomSettings = super.pomSettings().copy(organization = "de.acme")
  def unpacked: T[PathRef] = Task {
    for {
      dep <- defaultResolver().classpath(compileMvnDeps())
      jar = dep.path
    } {
      AcmeUtil.unpackZip(src = jar, dest = Task.dest, excludes = Seq("module.info"))
    }
    PathRef(Task.dest)
  }
  override def compile: T[CompilationResult] = Task {
    val dummy = Task.dest / "dummy"
    os.write(dummy, "")
    CompilationResult(dummy, unpacked())
  }
  override def sourceJar: T[PathRef] = Task {
    val src = Task.dest / "src"
    val out = Task.dest / "out.jar"
    os.makeDir(src)
    for {
      dep <- defaultResolver().classpath(compileMvnDeps(), sources = true)
      jar = dep.path
    } {
      AcmeUtil.unpackZip(src = jar, dest = src)
    }
    Jvm.createJar(jar = out, Seq(src), manifest(), fileFilter = (_,_) => true)
    PathRef(out)
  }
}

