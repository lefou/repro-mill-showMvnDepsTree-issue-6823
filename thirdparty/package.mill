// Everthing below is RCP module related

// generated with `cd thirdparty && mill writeGeneratedDepsMillSrc`
// you may need to uncomment the below line to generate
//import $file.out.writeGeneratedDepsMillSrc.dest.eclipse_bundles

case class Shaded(shadedArtifactId: String, archive: Archive, artifactId: String, version: String)

// TODO: document why we need to shade at all!
val shaded = Shaded(
  "shaded-org.eclipse.equinox.launcher.win32.win32.x86",
  Archives.rcp382,
  "org.eclipse.equinox.launcher.win32.win32.x86",
  "1.1.200.v20120913-144807"
)

/** All referenced Eclipse bundles. */
def rcpBundles: Set[ProvisionRequest] = {
  // trigger Deps creation
  Deps.init()

  Archive.bundles +
    ProvisionRequest(shaded.archive, shaded.shadedArtifactId, shaded.version)
}

/** Produce an empty JAR. */
def emptyJar: T[PathRef] = Task {
  val jar = Task.dest / "out.jar"
  Jvm.createJar(jar, Seq.empty[os.Path])
  PathRef(jar)
}

/** Generate a unique name for each eclipse archive to be used in the cross project. */
def rcpArchiveName(a: Archive) = s"${a.name}_${a.url.hashCode()}"

def eclipseArchives: Map[String, Archive] = Map(
  "rcp4_16" -> Archives.rcp4_16,
//  "rcp4_17" -> Archives.rcp4_17,
  "platform4_16" -> Archives.platform4_16,
  "jdt4_16" -> Archives.jdt4_16,
  "pde4_16" -> Archives.pde4_16,
//  "rcp4_20" -> Archives.rcp4_20
//  "sdk432win64" -> Archives.sdk432win64,
  "platform4_32" -> Archives.platform4_32
)

val rcpArchives: Seq[Archive] = (eclipseArchives.values.toSeq ++ rcpBundles.map(_.archive)).distinct

object rcp extends Cross[Rcp](rcpArchives.map(rcpArchiveName(_)).distinct)
trait Rcp extends Cross.Module[String] {
  def archiveName = crossValue
  def generatedValName = Task {
    eclipseArchives.to(LazyList).collect {
      case (n, a) if a.url == archive.url && a.source == archive.source => n
    }.headOption
  }
  def archive: Archive = {
    eclipseArchives.values.toList.find(rcpArchiveName(_) == archiveName).getOrElse {
      rcpBundles
        .to(LazyList)
        .collect {
          case x if rcpArchiveName(x.archive) == archiveName => x.archive
        }
        .head
    }
  }

  def requests: Set[ProvisionRequest] =
    rcpBundles.filter(r => rcpArchiveName(r.archive) == archiveName && r.archive.provision)

  /** Download Eclipse archive. */
  def downloadedArchive: T[PathRef] = Task(persistent = true) {
    val url = archive.url
    val targetFile = Task.dest / archiveName
    val urls = LazyList(s"http://localhost:7777/${archive.name}", url)
    val result = urls.map { url =>
      if (!os.exists(targetFile)) {
        try {
          Task.log.info(s"Downloading ${url} .. to ${targetFile}")
          val tmp = os.temp(_root_.requests.get.stream(url))
          os.move(tmp, targetFile)
          Task.log.info(s"Finished download of ${targetFile}")
          Success(targetFile)
        } catch {
          case NonFatal(e) =>
            Task.log.warn(s"Could not download ${url}: ${e.getMessage()}")
            Failure(e)
        }
      } else {
        Success(targetFile)
      }
    }
    result.find(_.isSuccess) match {
      case Some(target) => PathRef(target.get)
      case None => Task.fail(
          s"Could not download ${archive.name} from urls: ${urls.mkString(", ")}. Errors: ${result.mkString(", ")}"
        )
    }
  }

  def unpackedArchive: T[PathRef] = Task {
    val zip = downloadedArchive().path
    val target = Task.dest / s"${zip.last}.unpacked"
    os.unzip(zip, target)
    PathRef(target)
  }

  def bundleFiles = Task {
    val dir = os.Path(archive.bundlePath, unpackedArchive().path)
    val allJars = os.list(dir).filter(f => f.ext == "jar")
    allJars.map(PathRef(_))
  }

  /** return: bundle name, version, variable name, archive holder name, with sources */
  def bundles: T[Seq[(String, String, String, Option[String], Boolean)]] = Task {
    bundleFiles().flatMap { b =>
      val baseName = b.path.baseName
      val bName0 = baseName.split("[_][0-9]")(0)
      val bVersion0 = baseName.substring(bName0.size + 1)

      // special cases
      //  val `org.eclipse.pde.ds1` = build_eclipse.Archives.`pde4_16`("org.eclipse.pde.ds1", "2.lib.source_1.0.400.v20191119-0943")
      //  val `org.eclipse.pde.ds1` = build_eclipse.Archives.`pde4_16`("org.eclipse.pde.ds1", "2.lib_1.0.400.v20191119-0943")
      //  val `org.eclipse.jdt.annotation` = build_eclipse.Archives.`jdt4_16`("org.eclipse.jdt.annotation", "1.1.500.v20200407-1355")
      //  val `org.eclipse.jdt.annotation` = build_eclipse.Archives.`jdt4_16`("org.eclipse.jdt.annotation", "2.2.600.v20200408-1511")

      val (bName, bVersion, valName) =
        if (
          bVersion0.startsWith("32_") ||
          bVersion0.startsWith("32.source") ||
          bVersion0.startsWith("64_") ||
          bVersion0.startsWith("64.source") ||
          bVersion0.startsWith("2.lib")
        ) {
          // our split isn't good enough
          (bName0 + "_" + bVersion0.substring(0, 2), bVersion0.substring(3))

          val rest = bVersion0.split("[_][0-9]")
          val bName1 = bName0 + "_" + rest(0)
          (bName1, baseName.substring(bName1.size + 1), bName1)
        } else if (bName0 == "org.eclipse.jdt.annotation") {
          (bName0, bVersion0, bName0 + "_" + bVersion0.substring(0, 1))
        } else {
          (bName0, bVersion0, bName0)
        }

      if (bName.endsWith(".source")) Seq()
      else Seq((bName, bVersion, valName, generatedValName(), archive.source))
    }
  }

  object bundle extends Cross[Bundle](requests.map(_.artifactId).toSeq)
  trait Bundle extends Cross.Module[String] with ProvisionModule {
    def artifactId = crossValue
    def request = requests.find(_.artifactId == artifactId).head

    def shadeRequest = if (shaded.archive == archive && shaded.shadedArtifactId == artifactId) Some(shaded) else None

    def publishLocalData: T[(PathRef, PathRef, PathRef, PathRef, PathRef, Artifact)] = Task {
      // TODO: detect if there are embedded pom data in the jar and reuse these
      val archivePath = unpackedArchive().path
      val artifactMetadata = Artifact(archive.groupId, artifactId, request.version)

      val pomSettings = PomSettings(
        description = s"Republished eclipse bundle ${request.artifactId}_${request.version}",
        organization = archive.groupId,
        url = "ACME",
        licenses = Seq(),
        versionControl = VersionControl(),
        developers = Seq()
      )
      val pomFile = os.temp.apply(
        prefix = "pom",
        suffix = "xml",
        dir = Task.dest,
        deleteOnExit = false,
        contents = Pom(
          artifact = artifactMetadata,
          dependencies = Seq(),
          name = artifactId,
          pomSettings = pomSettings,
          properties = Map(),
          packagingType = "jar",
          parentProject = None,
          bomDependencies = Seq(),
          dependencyManagement = Seq()
        )
      )

      val ivyFile = os.temp.apply(
        prefix = "mvn",
        suffix = "xml",
        dir = Task.dest,
        deleteOnExit = false,
        contents = Ivy(artifactMetadata, Seq())
      )

      (
        jar(),
        sourceJar(),
        PathRef(emptyJar().path),
        PathRef(pomFile),
        PathRef(ivyFile),
        artifactMetadata
      )
    }

    /** The jar (extracted from archive), and potentially shaded with different manifest. */
    def jar: T[PathRef] = Task {
      shadeRequest match {
        case None =>
          PathRef(unpackedArchive().path / os.SubPath(archive.bundlePath) / s"${artifactId}_${request.version}.jar")
        case Some(Shaded(shadedArtifactId, archive, origId, version)) =>
          // we need to re-pack the jar with a different Manifest
          // how? We copy the file and then run the jar tool to inject a new manifest.
          val origJar = unpackedArchive().path / os.SubPath(archive.bundlePath) / s"${origId}_${version}.jar"
          val shadedJar = Task.dest / s"${artifactId}-${version}.jar"
          os.copy(origJar, shadedJar)

          val mfFile = Task.dest / "MANIFEST.MF"
          os.write(mfFile, s"Bundle-SymbolicName: ${artifactId};singleton:=true\n")
          os.call(
            cmd = ("jar", "uvfm", shadedJar.toString(), mfFile.toString()),
            env = Map(),
            cwd = Task.dest
          )

          PathRef(shadedJar)
      }
    }

    def sourceJar: T[PathRef] = Task {
      if (!archive.source) emptyJar()
      else {
        val jar = shadeRequest match {
          case None =>
            unpackedArchive().path / os.SubPath(archive.bundlePath) / s"${artifactId}.source_${request.version}.jar"
          case Some(Shaded(shadedArtifactId, archive, origId, version)) =>
            unpackedArchive().path / os.SubPath(archive.bundlePath) / s"${origId}_${request.version}.jar"
        }
        if (os.exists(jar)) {
          Task.log.error(s"Could not find a source jar for ${artifactId}")
          PathRef(jar)
        } else emptyJar()
      }
    }

    /** Publish Eclipse bundles into local ivy repo. */
    def publishLocalCached: T[Seq[PathRef]] = Task {
      publishLocalTask()
    }

    /** Publish Eclipse bundles into local ivy repo. */
    def publishLocal(): Command[Seq[PathRef]] = Task.Command {
      publishLocalTask()
    }

    def publishLocalTask: Task[Seq[PathRef]] = Task.Anon {
      val (jar, sourcesJar, docJar, pom, ivy, artifact) = publishLocalData()
      LocalIvyPublisher.publishLocal(
        pom = pom.path,
        ivy = Right(ivy.path),
        artifact = artifact,
        publishInfos = Seq(
          // private API in Mill 1.0
//          PublishInfo.jar(jar),
//          PublishInfo.sourcesJar(sourcesJar),
//          PublishInfo.docJar(docJar)
          PublishInfo(
            file = jar,
            ivyConfig = "compile",
            ivyType= "jar"
          ),
          PublishInfo(
            file = sourcesJar,
            ivyConfig = "compile",
            ivyType = "src",
            classifier = Some("sources")
          ),
          PublishInfo(
            file = docJar,
            ivyConfig = "compile",
            ivyType = "doc",
            classifier = Some("javadoc")
          )
        )
      )
        .map(PathRef(_, revalidate = Revalidate.Once))
    }

    /** Publish Eclipse bundles into local ivy repo. */
    def publishM2LocalCached: T[Seq[PathRef]] = Task {
      publishM2LocalTask()
    }

    /** Publish Eclipse bundles into local ivy repo. */
    def publishM2Local(): Command[Seq[PathRef]] = Task.Command {
      publishM2LocalTask()
    }

    def publishM2LocalTask: Task[Seq[PathRef]] = Task.Anon {
      val (jar, sourcesJar, docJar, pom, ivy, artifact) = publishLocalData()
      new LocalM2Publisher(os.home / ".m2" / "repository")
        .publish(
          pom = pom.path,
          artifact = artifact,
          publishInfos = Seq(
            // private API in Mill 1.0
            //          PublishInfo.jar(jar),
            //          PublishInfo.sourcesJar(sourcesJar),
            //          PublishInfo.docJar(docJar)
            PublishInfo(
              file = jar,
              ivyConfig = "compile",
              ivyType= "jar"
            ),
            PublishInfo(
              file = sourcesJar,
              ivyConfig = "compile",
              ivyType = "src",
              classifier = Some("sources")
            ),
            PublishInfo(
              file = docJar,
              ivyConfig = "compile",
              ivyType = "doc",
              classifier = Some("javadoc")
            )
          )
        )
        .map(PathRef(_, revalidate = Revalidate.Once))
    }

    def publishArtifacts: T[PublishModule.PublishData] = Task {
      val (jar, sourcesJar, docJar, pom, ivy, artifact) = publishLocalData()
      val baseName = s"${artifact.id}-${artifact.version}"
      PublishModule.PublishData(
        artifact,
        Seq(
          jar -> s"$baseName.jar",
          sourcesJar -> s"$baseName-sources.jar",
          docJar -> s"$baseName-javadoc.jar",
          pom -> s"$baseName.pom"
        )
      )
    }
  }
}

def bundles: Task.Simple[Seq[(String, String, String, Option[String], Boolean)]] = Task {
  Task.traverse(eclipseArchives.values.toSeq) { a =>
    rcp(rcpArchiveName(a)).bundles
  }().flatten
}

def showGeneratedDepsMillSrc() = Task.Command {
  println(generatedDepsMillSrc())
  ()
}

def writeGeneratedDepsMillSrc = Task {
  val file = Task.dest / "EclipseBundles.scala"
  os.write(file, generatedDepsMillSrc())
  PathRef(file)
}

def updateEclispeBundlesInPlace = Task {
  val dest = mill.api.BuildCtx.workspaceRoot / "mill-build/src/acmebuild/eclipse/EclipseBundles.scala"
  val gitRes = os.call(
    cmd = ("git", "status", "-s", "--", dest),
    cwd = mill.api.BuildCtx.workspaceRoot
  ).out.text()
  if(!gitRes.isBlank) {
    Result.Failure(s"File ${dest} is modified. Abouting to avoid data loss.")
  } else {
    os.write.over(dest, generatedDepsMillSrc())
    os.call(
      cmd = ("git", "status", "-s", "--", dest),
      cwd = mill.api.BuildCtx.workspaceRoot,
      stdout = os.Inherit
    )
    Result.Success(PathRef(dest))
  }
}

def generatedDepsMillSrc = Task {
  // valName, count, withSources
  var seen: Map[String, (Int, Boolean)] = Map()
  Seq(
    Seq(
      "/** Generated file with `mill thirdparty.updateEclispeBundlesInPlace` */",
      s"package acmebuild.eclipse",
      "",
      "/**",
      " * Dependencies extracted from the following archives:"
    ),
    eclipseArchives.map { case (name, a) => s" * - ${name}: ${a.url}" },
    Seq(
      " *",
      " * Dependencies explicitly requested via `ProvisionRequest`s from:"
    ),
    rcpBundles.map(b => b.archive.url)
      .toSeq
      .sorted
      .map { case url => s" * - ${url}" },
    Seq(
      " */",
      s"""trait EclipseBundles {"""
    ),
    bundles().sortBy(_._3).map {
      case (bName, bVersion, valName, Some(archiveValName), withSources) =>
        val (count, sourcesPresent) = seen.getOrElse(valName, (0, false))
        seen = seen.updated(valName, (count + 1, sourcesPresent || withSources))
        //            val archiveValName = eclipseArchives.find(_._2 == archive)
        s"""  val `${valName}${if (count > 0) s"_${archiveValName}"
        else ""}` = Archives.`${archiveValName}`${if (sourcesPresent) ".noProvision"
        else ""}("${bName}", "${bVersion}")"""
    },
    Seq(
      "}",
      s"object EclipseBundles extends EclipseBundles"
    )
  ).flatten.mkString("\n")
}
